        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/watlis_background</item>
        <item name="android:navigationBarColor">@color/watlis_background</item>
        <item name="android:colorAccent">@color/watlis_accent</item>
        <item name="colorPrimary">@color/watlis_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/watlis_accent</item>
        <item name="colorSurface">@color/watlis_surface</item>
